server {
    listen 80;
    listen [::]:80;
    server_name check-in-bot.ruthgracewong.com www.check-in-bot.ruthgracewong.com;

    location ~ /.well-known {
        root /var/www/check-in-bot/static;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name check-in-bot.ruthgracewong.com www.check-in-bot.ruthgracewong.com;
    ssl_certificate /etc/letsencrypt/live/www.check-in-bot.ruthgracewong.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.check-in-bot.ruthgracewong.com/privkey.pem;

    location /slack {
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        root /var/www/check-in-bot/static;
    }
}
